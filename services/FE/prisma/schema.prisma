generator client {
  provider = "prisma-client-js"
}

// NOTE: When using mysql or sqlserver, uncomment the //@db.Text annotations in model Account below
// Further reading:
// https://www.prisma.io/docs/reference/api-reference/prisma-schema-reference#string

datasource db {
  provider = "sqlite"
}

model CanvasFingerprint {
  id        String @id @default(cuid())
  hash      String
  width     Int
  height    Int
  method    String // toDataURL, toBlob, etc.
  sourceUrl String // URL where canvas was captured
  pixelData String // base64 encoded image data

  createdAt DateTime @default(now())

  renders CanvasRender[]

  @@unique([hash])
}

model CanvasRender {
  id String @id @default(cuid())

  fingerprintId String
  fingerprint   CanvasFingerprint @relation(fields: [fingerprintId], references: [id], onDelete: Cascade)

  deviceInfo String // User agent or device identifier
  dataURL    String // Rendered base64 image
  createdAt  DateTime @default(now())

  @@map("canvas_render")
}

model Profile {
  id                String   @id @default(cuid())
  name              String   @unique // "Firefox-1920x1080-a3f2" or custom
  browser           String
  screenWidth       Int
  screenHeight      Int
  hashSuffix        String // 4-char hash from fingerprint config
  fingerprintConfig Json   // Native JSON for 100+ fingerprint properties
  userAgent         String
  detectorVersion   Int    // Version of fingerprint-detector.ts used

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  canvasFingerprints ProfileCanvasFingerprint[]
}

model ProfileCanvasFingerprint {
  id        String  @id @default(cuid())
  profileId String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  hash    String // e.g., "240x60_1cfc1c01ffff0700"
  width   Int
  height  Int
  method  String
  dataURL String // Base64 PNG for Camoufox spoofing

  createdAt DateTime @default(now())

  @@index([profileId])
}
