{
  "name": "canvas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun --bun next build",
    "check": "bun --bun next lint && tsc --noEmit",
    "db:generate": "prisma migrate dev",
    "db:migrate": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "dev": "bun --bun next dev --turbo",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "format:write": "prettier --write \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "postinstall": "prisma generate",
    "lint": "bun --bun next lint",
    "lint:fix": "bun --bun next lint --fix",
    "start": "bun --bun next start",
    "typecheck": "bun --bun tsc --noEmit",
    "preview": "bun --bun opennextjs-cloudflare build && bun --bun opennextjs-cloudflare preview",
    "deploy": "bun --bun opennextjs-cloudflare build && bun --bun opennextjs-cloudflare deploy",
    "upload": "bun --bun opennextjs-cloudflare build && bun --bun opennextjs-cloudflare upload",
    "cf-typegen": "bun --bun wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "2.7.2",
    "@libsql/client": "0.15.0",
    "@opennextjs/cloudflare": "1.14.0",
    "@prisma/adapter-d1": "7.0.1",
    "@prisma/adapter-libsql": "7.0.0",
    "@prisma/client": "^7.1.0",
    "@t3-oss/env-nextjs": "0.12.0",
    "@tanstack/react-query": "5.69.0",
    "@trpc/client": "11.0.0",
    "@trpc/react-query": "11.0.0",
    "@trpc/server": "11.0.0",
    "dotenv": "17.2.3",
    "next": "16.0.6",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "server-only": "0.0.1",
    "superjson": "2.2.1",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.1",
    "@tailwindcss/postcss": "4.0.15",
    "@types/node": "20.14.10",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "eslint": "9.23.0",
    "eslint-config-next": "16.0.6",
    "postcss": "8.5.3",
    "prettier": "3.5.3",
    "prettier-plugin-tailwindcss": "0.6.11",
    "prisma": "^7.1.0",
    "tailwindcss": "4.0.15",
    "typescript": "5.8.2",
    "typescript-eslint": "8.27.0",
    "wrangler": "4.51.0"
  },
  "ct3aMetadata": {
    "initVersion": "7.40.0"
  },
  "overrides": {
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3"
  },
  "patchedDependencies": {
    "@t3-oss/env-core@0.12.0": "patches/@t3-oss%2Fenv-core@0.12.0.patch"
  }
}
