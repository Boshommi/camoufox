+JSObject* MemoryInfo::WrapObject(JSContext* aCx,
+                                 JS::Handle<JSObject*> aGivenProto) {
+  return MemoryInfo_Binding::Wrap(aCx, this, aGivenProto);
+}
+
+uint64_t MemoryInfo::JsHeapSizeLimit() const {
+  // Return a reasonable default heap limit (4GB)
+  // Chrome typically reports the V8 heap limit
+  return 4294967296ULL;
+}
+
+uint64_t MemoryInfo::TotalJSHeapSize() const {
+  // Return a plausible total heap size
+  // In practice, we could try to get actual values from SpiderMonkey
+  return 50000000ULL;  // ~50MB as a reasonable default
+}
+
+uint64_t MemoryInfo::UsedJSHeapSize() const {
+  // Return a plausible used heap size (less than total)
+  return 35000000ULL;  // ~35MB as a reasonable default
+}
+
+}  // namespace mozilla::dom
