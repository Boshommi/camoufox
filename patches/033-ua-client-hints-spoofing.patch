+/* -*- Mode: IDL; tab-width: 2; indent-tabs-mode: nil; c-basic-offset: 2 -*- */
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this file,
+ * You can obtain one at http://mozilla.org/MPL/2.0/.
+ *
+ * https://wicg.github.io/ua-client-hints/
+ */
+
+dictionary NavigatorUABrandVersion {
+  DOMString brand = "";
+  DOMString version = "";
+};
+
+dictionary UADataValues {
+  sequence<NavigatorUABrandVersion> brands;
+  boolean mobile = false;
+  DOMString platform = "";
+  DOMString architecture = "";
+  DOMString bitness = "";
+  DOMString model = "";
+  DOMString platformVersion = "";
+  sequence<NavigatorUABrandVersion> fullVersionList;
+  boolean wow64 = false;
+};
+
+[Exposed=(Window,Worker)]
+interface NavigatorUAData {
+  [Cached, Pure]
+  readonly attribute sequence<NavigatorUABrandVersion> brands;
+  readonly attribute boolean mobile;
+  readonly attribute DOMString platform;
+
+  [NewObject]
+  Promise<UADataValues> getHighEntropyValues(sequence<DOMString> hints);
+
+  [Default] object toJSON();
+};
