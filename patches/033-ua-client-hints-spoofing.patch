+NavigatorUAData* WorkerNavigator::UserAgentData() {
+  // Check if userAgentData is disabled
+  if (auto enabled = MaskConfig::GetBool("navigator.userAgentData")) {
+    if (!*enabled) {
+      return nullptr;
+    }
+  }
+
+  if (!mUserAgentData) {
+    WorkerPrivate* workerPrivate = GetCurrentThreadWorkerPrivate();
+    MOZ_ASSERT(workerPrivate);
+
+    nsIGlobalObject* global = workerPrivate->GlobalScope();
+    MOZ_ASSERT(global);
+
+    mUserAgentData = new NavigatorUAData(global);
+  }
+  return mUserAgentData;
+}
