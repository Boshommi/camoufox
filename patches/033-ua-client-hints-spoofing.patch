+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+#include "NavigatorUAData.h"
+#include "MaskConfig.hpp"
+
+#include "mozilla/dom/NavigatorUADataBinding.h"
+#include "mozilla/dom/Promise.h"
+#include "nsIGlobalObject.h"
+
+namespace mozilla::dom {
+
+NS_IMPL_CYCLE_COLLECTION_WRAPPERCACHE(NavigatorUAData, mGlobal)
+
+NS_IMPL_CYCLE_COLLECTING_ADDREF(NavigatorUAData)
+NS_IMPL_CYCLE_COLLECTING_RELEASE(NavigatorUAData)
+
+NS_INTERFACE_MAP_BEGIN_CYCLE_COLLECTION(NavigatorUAData)
+  NS_WRAPPERCACHE_INTERFACE_MAP_ENTRY
+  NS_INTERFACE_MAP_ENTRY(nsISupports)
+NS_INTERFACE_MAP_END
+
+NavigatorUAData::NavigatorUAData(nsIGlobalObject* aGlobal)
+    : mGlobal(aGlobal), mBrandsInitialized(false) {}
+
+NavigatorUAData::~NavigatorUAData() = default;
+
+JSObject* NavigatorUAData::WrapObject(JSContext* aCx,
+                                      JS::Handle<JSObject*> aGivenProto) {
+  return NavigatorUAData_Binding::Wrap(aCx, this, aGivenProto);
+}
+
+void NavigatorUAData::InitBrands() {
+  if (mBrandsInitialized) {
+    return;
+  }
+  mBrandsInitialized = true;
+
+  auto data = MaskConfig::GetJson();
+  const char* key = "navigator.userAgentData:brands";
+
+  if (data.contains(key) && data[key].is_array()) {
+    for (const auto& item : data[key]) {
+      if (item.contains("brand") && item.contains("version")) {
+        NavigatorUABrandVersion brand;
+        brand.mBrand.Assign(
+            NS_ConvertUTF8toUTF16(item["brand"].get<std::string>()));
+        brand.mVersion.Assign(
+            NS_ConvertUTF8toUTF16(item["version"].get<std::string>()));
+        mBrands.AppendElement(brand);
+      }
+    }
+  } else {
+    // Default Chrome-like brands
+    NavigatorUABrandVersion chromium;
+    chromium.mBrand.AssignLiteral(u"Chromium");
+    chromium.mVersion.AssignLiteral(u"120");
+    mBrands.AppendElement(chromium);
+
+    NavigatorUABrandVersion notABrand;
+    notABrand.mBrand.AssignLiteral(u"Not_A Brand");
+    notABrand.mVersion.AssignLiteral(u"8");
+    mBrands.AppendElement(notABrand);
+  }
+}
+
+void NavigatorUAData::GetBrands(nsTArray<NavigatorUABrandVersion>& aBrands) {
+  InitBrands();
+  aBrands = mBrands.Clone();
+}
+
+bool NavigatorUAData::Mobile() const {
+  if (auto value = MaskConfig::GetBool("navigator.userAgentData:mobile")) {
+    return *value;
+  }
+  return false;  // Default to desktop
+}
+
+void NavigatorUAData::GetPlatform(nsAString& aPlatform) const {
+  if (auto value = MaskConfig::GetString("navigator.userAgentData:platform")) {
+    aPlatform.Assign(NS_ConvertUTF8toUTF16(*value));
+    return;
+  }
+  aPlatform.AssignLiteral(u"Windows");  // Default platform
+}
+
+already_AddRefed<Promise> NavigatorUAData::GetHighEntropyValues(
+    const Sequence<nsString>& aHints, ErrorResult& aRv) {
+  if (!mGlobal) {
+    aRv.Throw(NS_ERROR_UNEXPECTED);
+    return nullptr;
+  }
+
+  RefPtr<Promise> promise = Promise::Create(mGlobal, aRv);
+  if (aRv.Failed()) {
+    return nullptr;
+  }
+
+  UADataValues result;
+
+  // Always include low-entropy values
+  InitBrands();
+  result.mBrands.Construct(mBrands.Clone());
+  result.mMobile = Mobile();
+  GetPlatform(result.mPlatform);
+
+  auto data = MaskConfig::GetJson();
+
+  // Process requested high-entropy hints
+  for (const auto& hint : aHints) {
+    if (hint.EqualsLiteral("architecture")) {
+      if (auto value =
+              MaskConfig::GetString("navigator.userAgentData:architecture")) {
+        result.mArchitecture.Assign(NS_ConvertUTF8toUTF16(*value));
+      } else {
+        result.mArchitecture.AssignLiteral(u"x86");
+      }
+    } else if (hint.EqualsLiteral("bitness")) {
+      if (auto value =
+              MaskConfig::GetString("navigator.userAgentData:bitness")) {
+        result.mBitness.Assign(NS_ConvertUTF8toUTF16(*value));
+      } else {
+        result.mBitness.AssignLiteral(u"64");
+      }
+    } else if (hint.EqualsLiteral("model")) {
+      if (auto value = MaskConfig::GetString("navigator.userAgentData:model")) {
+        result.mModel.Assign(NS_ConvertUTF8toUTF16(*value));
+      } else {
+        result.mModel.AssignLiteral(u"");
+      }
+    } else if (hint.EqualsLiteral("platformVersion")) {
+      if (auto value =
+              MaskConfig::GetString("navigator.userAgentData:platformVersion")) {
+        result.mPlatformVersion.Assign(NS_ConvertUTF8toUTF16(*value));
+      } else {
+        result.mPlatformVersion.AssignLiteral(u"10.0.0");
+      }
+    } else if (hint.EqualsLiteral("wow64")) {
+      if (auto value = MaskConfig::GetBool("navigator.userAgentData:wow64")) {
+        result.mWow64 = *value;
+      }
+    } else if (hint.EqualsLiteral("fullVersionList")) {
+      nsTArray<NavigatorUABrandVersion> fullVersionList;
+      const char* fvlKey = "navigator.userAgentData:fullVersionList";
+      if (data.contains(fvlKey) && data[fvlKey].is_array()) {
+        for (const auto& item : data[fvlKey]) {
+          if (item.contains("brand") && item.contains("version")) {
+            NavigatorUABrandVersion brand;
+            brand.mBrand.Assign(
+                NS_ConvertUTF8toUTF16(item["brand"].get<std::string>()));
+            brand.mVersion.Assign(
+                NS_ConvertUTF8toUTF16(item["version"].get<std::string>()));
+            fullVersionList.AppendElement(brand);
+          }
+        }
+      } else {
+        // Default to same as brands but with full version
+        NavigatorUABrandVersion chromium;
+        chromium.mBrand.AssignLiteral(u"Chromium");
+        chromium.mVersion.AssignLiteral(u"120.0.0.0");
+        fullVersionList.AppendElement(chromium);
+
+        NavigatorUABrandVersion notABrand;
+        notABrand.mBrand.AssignLiteral(u"Not_A Brand");
+        notABrand.mVersion.AssignLiteral(u"8.0.0.0");
+        fullVersionList.AppendElement(notABrand);
+      }
+      result.mFullVersionList.Construct(std::move(fullVersionList));
+    }
+  }
+
+  promise->MaybeResolve(result);
+  return promise.forget();
+}
+
+void NavigatorUAData::ToJSON(JSContext* aCx,
+                             JS::MutableHandle<JSObject*> aRetval,
+                             ErrorResult& aRv) {
+  // Create a plain JS object with brands, mobile, and platform
+  JS::Rooted<JSObject*> obj(aCx, JS_NewPlainObject(aCx));
+  if (!obj) {
+    aRv.Throw(NS_ERROR_OUT_OF_MEMORY);
+    return;
+  }
+
+  // Add brands array
+  InitBrands();
+  JS::Rooted<JSObject*> brandsArray(aCx,
+                                    JS::NewArrayObject(aCx, mBrands.Length()));
+  if (!brandsArray) {
+    aRv.Throw(NS_ERROR_OUT_OF_MEMORY);
+    return;
+  }
+
+  for (uint32_t i = 0; i < mBrands.Length(); i++) {
+    JS::Rooted<JSObject*> brandObj(aCx, JS_NewPlainObject(aCx));
+    if (!brandObj) {
+      aRv.Throw(NS_ERROR_OUT_OF_MEMORY);
+      return;
+    }
+
+    JS::Rooted<JSString*> brandStr(
+        aCx, JS_NewUCStringCopyN(aCx, mBrands[i].mBrand.get(),
+                                 mBrands[i].mBrand.Length()));
+    JS::Rooted<JSString*> versionStr(
+        aCx, JS_NewUCStringCopyN(aCx, mBrands[i].mVersion.get(),
+                                 mBrands[i].mVersion.Length()));
+
+    if (!brandStr || !versionStr) {
+      aRv.Throw(NS_ERROR_OUT_OF_MEMORY);
+      return;
+    }
+
+    if (!JS_DefineProperty(aCx, brandObj, "brand", brandStr, JSPROP_ENUMERATE) ||
+        !JS_DefineProperty(aCx, brandObj, "version", versionStr,
+                           JSPROP_ENUMERATE)) {
+      aRv.Throw(NS_ERROR_FAILURE);
+      return;
+    }
+
+    JS::Rooted<JS::Value> brandVal(aCx, JS::ObjectValue(*brandObj));
+    if (!JS_SetElement(aCx, brandsArray, i, brandVal)) {
+      aRv.Throw(NS_ERROR_FAILURE);
+      return;
+    }
+  }
+
+  JS::Rooted<JS::Value> brandsVal(aCx, JS::ObjectValue(*brandsArray));
+  if (!JS_DefineProperty(aCx, obj, "brands", brandsVal, JSPROP_ENUMERATE)) {
+    aRv.Throw(NS_ERROR_FAILURE);
+    return;
+  }
+
+  // Add mobile
+  JS::Rooted<JS::Value> mobileVal(aCx, JS::BooleanValue(Mobile()));
+  if (!JS_DefineProperty(aCx, obj, "mobile", mobileVal, JSPROP_ENUMERATE)) {
+    aRv.Throw(NS_ERROR_FAILURE);
+    return;
+  }
+
+  // Add platform
+  nsString platform;
+  GetPlatform(platform);
+  JS::Rooted<JSString*> platformStr(
+      aCx, JS_NewUCStringCopyN(aCx, platform.get(), platform.Length()));
+  if (!platformStr) {
+    aRv.Throw(NS_ERROR_OUT_OF_MEMORY);
+    return;
+  }
+  JS::Rooted<JS::Value> platformVal(aCx, JS::StringValue(platformStr));
+  if (!JS_DefineProperty(aCx, obj, "platform", platformVal, JSPROP_ENUMERATE)) {
+    aRv.Throw(NS_ERROR_FAILURE);
+    return;
+  }
+
+  aRetval.set(obj);
+}
+
+}  // namespace mozilla::dom
