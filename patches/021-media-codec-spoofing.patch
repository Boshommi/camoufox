 void HTMLMediaElement::CanPlayType(const nsAString& aType, nsAString& aResult) {
+  // Camoufox: Check for media codec override
+  std::string mimeType = NS_ConvertUTF16toUTF8(aType).get();
+  if (auto override = MaskConfig::GetNested("mediaCodec:overrides", mimeType)) {
+    std::string value = override->get<std::string>();
+    if (value == "probably") {
+      aResult.AssignLiteral("probably");
+    } else if (value == "maybe") {
+      aResult.AssignLiteral("maybe");
+    } else {
+      aResult.Truncate();  // "" means cannot play
+    }
+    LOG(LogLevel::Debug,
+        ("%p CanPlayType(%s) = \"%s\" (spoofed)", this, mimeType.c_str(),
+         value.c_str()));
+    return;
+  }
+
   DecoderDoctorDiagnostics diagnostics;
   CanPlayStatus canPlay = GetCanPlay(aType, &diagnostics);
   diagnostics.StoreFormatDiagnostics(OwnerDoc(), aType, canPlay != CANPLAY_NO,
