 PointerCapabilities Gecko_MediaFeatures_PrimaryPointerCapabilities(
     const Document* aDocument) {
+  // Spoofing check for pointer/hover media queries
+  if (auto pointerValue = MaskConfig::GetString("mediaQuery:pointer")) {
+    PointerCapabilities caps = PointerCapabilities(0);
+    if (*pointerValue == "fine") {
+      caps = PointerCapabilities::Fine;
+    } else if (*pointerValue == "coarse") {
+      caps = PointerCapabilities::Coarse;
+    }
+    // Check hover capability
+    if (auto hoverValue = MaskConfig::GetString("mediaQuery:hover")) {
+      if (*hoverValue == "hover") {
+        caps = caps | PointerCapabilities::Hover;
+      }
+    }
+    return caps;
+  }
+
   return GetPointerCapabilities(aDocument,
                                 LookAndFeel::IntID::PrimaryPointerCapabilities);
 }
 
 PointerCapabilities Gecko_MediaFeatures_AllPointerCapabilities(
     const Document* aDocument) {
+  // Spoofing check for any-pointer/any-hover media queries
+  if (auto pointerValue = MaskConfig::GetString("mediaQuery:any-pointer")) {
+    PointerCapabilities caps = PointerCapabilities(0);
+    if (*pointerValue == "fine") {
+      caps = PointerCapabilities::Fine;
+    } else if (*pointerValue == "coarse") {
+      caps = PointerCapabilities::Coarse;
+    }
+    // Check any-hover capability
+    if (auto hoverValue = MaskConfig::GetString("mediaQuery:any-hover")) {
+      if (*hoverValue == "hover") {
+        caps = caps | PointerCapabilities::Hover;
+      }
+    }
+    return caps;
+  }
+
   return GetPointerCapabilities(aDocument,
                                 LookAndFeel::IntID::AllPointerCapabilities);
 }
